  "finding": {
    "id": "REAL-R1-KEY-OTHER-01",
    "classification": "input_ontology_and_assessment_key_ambiguity_candidate",
    "affected_contract_field": {
      "type": "string",
      "description": "Procurement category. construction means prime construction; other may contain uncharacterised work.",
      "enum": [
        "prime_construction",
        "open_market_supplies",
        "transportation",
        "intelligence_transmission",
        "other"
      ]
    },
    "source_pages": [
      12
    ],
    "source_quote": "When required by the federal program legislation, all prime construction contracts over $2,000 awarded by recipients or subrecipients must include a provision for compliance with the Davis-Bacon Act.",
    "source_requirement": "Contract classification and program-legislation applicability matter. The source also tells recipients to consult program guidance to determine applicability and expressly excludes PA/HMA.",
    "key_assumption": "The key sets false whenever contract_category is not prime_construction, including other. This treats other as a positive assertion of known non-prime-construction status.",
    "alternative_input_reading": "The input description says other may contain uncharacterised work. A category not yet established does not establish that it is nonconstruction. Program-legislation applicability is also unknown in the three affected cases.",
    "observed_models": "OpenAI reaches default unknown; Anthropic reaches its explicit program-legislation unknown branch. Neither converts the supplied uncertain applicability into a mandatory clause.",
    "advisory_conclusion": "The six disagreements expose one ambiguity in the authored input ontology/key. Unknown is defensible under the unclassified-work reading. False is defensible only if the enum values are intended as exhaustive mutually exclusive classifications with other guaranteeing nonconstruction, a guarantee the field description does not clearly provide. The observed differences do not establish six model errors.",
    "evaluator_assessment": "The inspected first-matching-rule traces match the generated JSON conditions. No DSL interpreter defect was identified for these six decisions; this does not audit every evaluator path.",
    "current_reporting": "Retain all frozen expected values and six recorded disagreements. Add this advisory note beside the descriptive draft-key agreement. Do not change the denominator, add accepted labels or assign an accuracy penalty/credit after observing outputs.",
    "future_revision": "Before a separately identified future campaign, distinguish known_nonconstruction from unclassified (or provide a tri-state is_prime_construction field). Keep applicability facts separate from source knowledge, freeze the mapping, and add explicit paired cases for classification known/unknown and legislation yes/no/unknown.",
    "human_adjudication": "pending"
  },
